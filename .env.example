# Backend
TRIPOSR_MODEL_SAVE_FORMAT=glb
TRIPOSR_REPO_DIR=project/external/TripoSR
YOLO_DETECTION_CONFIDENCE=0.20
YOLO_DETECTION_IMAGE_SIZE=640

# Use this for Google Cloud GPU VM / Cloudflare worker mode.
RECONSTRUCTION_BACKEND=hunyuan_remote
HUNYUAN_REMOTE_URL=https://YOUR_WORKER_8010_URL
HUNYUAN_REMOTE_OUTPUT_FORMAT=glb
HUNYUAN_REMOTE_ENABLE_TEXTURE=false
HUNYUAN_REMOTE_TIMEOUT_SECONDS=1800
HUNYUAN_REMOTE_POLL_INTERVAL_SECONDS=5

# Mobile / Expo
EXPO_PUBLIC_API_BASE_URL=http://YOUR_BACKEND_HOST:8000

